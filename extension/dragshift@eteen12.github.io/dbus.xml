<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!-- Exported at /io/github/eteen12/DragShift under the well-known name
     io.github.eteen12.DragShift on the session bus. The Python client lives in
     dragshift/platform_linux.py; keep the names there in sync. -->
<node>
  <interface name="io.github.eteen12.DragShift">
    <!-- DragShift version this extension was built from (version-name in metadata.json,
         written by extension/build.sh). The app warns when it differs from its own. -->
    <method name="Version">
      <arg name="version" type="s" direction="out"/>
    </method>
    <!-- Global pointer position in stage (logical) pixels and the Clutter.ModifierType
         mask: SHIFT 1<<0, CONTROL 1<<2, MOD1 (Alt) 1<<3, BUTTON1 1<<8; other bits
         (Num Lock, Super, ...) are passed through for the app to ignore. Polled by the
         app's trigger every 15 ms, so it does nothing but read global.get_pointer(). -->
    <method name="GetPointer">
      <arg name="x" type="i" direction="out"/>
      <arg name="y" type="i" direction="out"/>
      <arg name="mask" type="u" direction="out"/>
    </method>
    <!-- Window placement (#10). Native Wayland clients cannot place or raise their own
         windows, so DragShift's menu and toasts ask here. Puts the CALLER's own window
         titled `title` (matched by the caller's pid, never another app's window) with its
         frame's top-left at (x, y) in stage (logical) pixels, keeps it above other windows
         and hands the keyboard focus back to the window that had it. When no such window
         is mapped yet, the placement is remembered and applied as it maps, before its
         first frame; the latest call per title wins and the rules are dropped when the
         caller leaves the bus. Returns whether a mapped window was moved now. -->
    <method name="PlaceWindow">
      <arg name="title" type="s" direction="in"/>
      <arg name="x" type="i" direction="in"/>
      <arg name="y" type="i" direction="in"/>
      <arg name="placed" type="b" direction="out"/>
    </method>
    <!-- Escape (#24). WatchEscape(true) grabs Escape as a global accelerator for the
         caller and returns whether the grab is held; EscapePressed is emitted on every
         press while it is. WatchEscape(false) releases it (returns false). The grab ends
         by itself when the caller's bus connection closes. -->
    <method name="WatchEscape">
      <arg name="on" type="b" direction="in"/>
      <arg name="watching" type="b" direction="out"/>
    </method>
    <signal name="EscapePressed"/>
    <!-- CaptureArea (#26): the screen under a rect in stage (logical) pixels, without
         the drag icon (Mutter's feedback group for Wayland drags, DND-type windows for
         X11 ones) and without the cursor. The rect is clamped to the stage and the
         clamped rect is returned. Its pixels come as PNGs of horizontal strips, top to
         bottom (encoded in parallel), each the full width; stacked they are the clamped
         rect times the monitor scale. An empty rect, or one entirely off the stage, is
         an InvalidArgs error. Calls are served one at a time. -->
    <method name="CaptureArea">
      <arg name="x" type="i" direction="in"/>
      <arg name="y" type="i" direction="in"/>
      <arg name="width" type="i" direction="in"/>
      <arg name="height" type="i" direction="in"/>
      <arg name="area_x" type="i" direction="out"/>
      <arg name="area_y" type="i" direction="out"/>
      <arg name="area_width" type="i" direction="out"/>
      <arg name="area_height" type="i" direction="out"/>
      <arg name="strips" type="aay" direction="out"/>
    </method>
    <!-- CaptureAreaExcludingCaller (#28): CaptureArea that also leaves out every window
         of the calling process (its pid from the bus daemon, matched against the
         windows' pids), hidden only during the same offscreen paint. Lets the app
         re-capture what is behind its own visible toasts and tool windows. Arguments,
         reply and errors as CaptureArea; queued with it. -->
    <method name="CaptureAreaExcludingCaller">
      <arg name="x" type="i" direction="in"/>
      <arg name="y" type="i" direction="in"/>
      <arg name="width" type="i" direction="in"/>
      <arg name="height" type="i" direction="in"/>
      <arg name="area_x" type="i" direction="out"/>
      <arg name="area_y" type="i" direction="out"/>
      <arg name="area_width" type="i" direction="out"/>
      <arg name="area_height" type="i" direction="out"/>
      <arg name="strips" type="aay" direction="out"/>
    </method>
    <!-- GetWorkArea (#42): the work area (monitor minus the top bar and a fixed dock,
         Main.layoutManager.getWorkAreaForMonitor) of the monitor that contains (x, y),
         else of the primary monitor, in stage (logical) pixels. Toasts stack at its
         bottom right; under Wayland Qt only knows the whole monitor. Read-only. -->
    <method name="GetWorkArea">
      <arg name="x" type="i" direction="in"/>
      <arg name="y" type="i" direction="in"/>
      <arg name="area_x" type="i" direction="out"/>
      <arg name="area_y" type="i" direction="out"/>
      <arg name="area_width" type="i" direction="out"/>
      <arg name="area_height" type="i" direction="out"/>
    </method>
    <!-- GetOwnWindowFrame (#40): the frame rect, in stage (logical) pixels, of the
         CALLER's own window titled `title` (matched by the caller's pid, like
         CaptureAreaExcludingCaller), and whether it is mapped; (false, 0, 0, 0, 0) when
         no such window is on screen. Under Wayland the app is never told where its
         windows are; its glass windows capture what is behind them there. Read-only. -->
    <method name="GetOwnWindowFrame">
      <arg name="title" type="s" direction="in"/>
      <arg name="mapped" type="b" direction="out"/>
      <arg name="x" type="i" direction="out"/>
      <arg name="y" type="i" direction="out"/>
      <arg name="width" type="i" direction="out"/>
      <arg name="height" type="i" direction="out"/>
    </method>
  </interface>
</node>
